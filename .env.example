# ig-ray / .env.example
#   cp .env.example .env  して編集する。.env は git に入れないこと。

# ---- 必須 -------------------------------------------------------------
# ログインに使うIGアカウント名（捨てアカ推奨）
IG_RAY_LOGIN_USER=

# ---- 権限 -------------------------------------------------------------
# ./data の所有者に合わせる。`id -u` / `id -g` の結果を入れる。
IG_RAY_UID=1000
IG_RAY_GID=1000

# ---- 取得の挙動 -------------------------------------------------------
# 動画本体もDLするか（1でON、容量注意）
IG_RAY_DOWNLOAD_VIDEOS=0
# バッチ間の休憩秒（ランダム）
IG_RAY_SLEEP_MIN=3
IG_RAY_SLEEP_MAX=8
# これを超える待機を要求されたら中止する秒数
IG_RAY_MAX_SLEEP=60

# web_profile_info が恒常的に 429 で弾かれる環境では 1 にする。
# プロフィール詳細（followers等）は取れなくなるが、投稿取得は通る。
IG_RAY_POSTS_ONLY=0

# ジオタグを取るか。1 にすると投稿ごとに追加のHTTPリクエストが飛ぶ（レート制限に直結）
IG_RAY_FETCH_LOCATION=0

# 動画URLを instaloader の Post.video_url プロパティ経由で取るか。
# 1 にすると **動画投稿1件につきCDNへHEADが2〜4回**飛ぶ（解像度候補の比較のため）。
# 既定 0 では生ノードから読むので追加リクエストなし。
# 最高画質を厳密に選びたいとき（IG_RAY_DOWNLOAD_VIDEOS=1 のとき）だけ 1 に。
IG_RAY_VIDEO_URL_PROBE=0

# キャッシュの保持日数（ストレージ画面の「N日より古い分を削除」で使用）
IG_RAY_CACHE_RETENTION_DAYS=30

# ---- 出口の分離（別回線のプロキシ経由で出す・任意） --------------------
# 普段使いの回線と IP レピュテーションを切り離したい場合に設定する。
# worker 系のコンテナだけがこれを使う。設定後は必ず
#   docker compose run --rm ipcheck
# で出口IPを確認すること（入れ忘れたコンテナは IPv6 で本来の回線から出る）。
#HTTP_PROXY=http://<プロキシのIP>:8888
#HTTPS_PROXY=http://<プロキシのIP>:8888
NO_PROXY=localhost,127.0.0.1

# 期待する出口IP。設定すると ipcheck が自動判定して不一致で非ゼロ終了する
#IG_RAY_EXPECT_EGRESS_IP=<分離先回線のグローバルIP>

# ---- ネットワーク -----------------------------------------------------
# IPが弾かれている場合、別経路のプロキシを噛ませる
# IG_RAY_PROXY=http://user:pass@host:port

# ---- 全件バックフィル（--profile backfill を使う場合のみ） --------------
# ページ間の休憩（秒）。1ページ12件なので、既定10〜20分だと1日1000件強のペース。
# 数日〜1週間かける前提なので、速度より「429を一度も出さないこと」を優先する。
IG_RAY_BACKFILL_PAGE_SLEEP_MIN=600
IG_RAY_BACKFILL_PAGE_SLEEP_MAX=1200
# 保管済みの投稿がこの件数連続したら打ち切る（2周目以降のみ。初回は最後まで走る）
IG_RAY_BACKFILL_KNOWN_STREAK=30
# cron の巡回が直近この秒数以内に動いていたら待つ
IG_RAY_BACKFILL_QUIET_SEC=180
# 429 を食ったときのバックオフ（秒）
IG_RAY_BACKFILL_RATELIMIT_BACKOFF=3600

# ---- 定期巡回（--profile cron を使う場合のみ） -------------------------
# 巡回間隔（秒）。既定6時間。短くしすぎるとブロックされる。
# ここを変えたら web の「次回巡回」表示も自動で追従する（実行側が記録するため）
IG_RAY_INTERVAL=21600
# 1アカウントあたりの取得件数
IG_RAY_CRON_LIMIT=6

# ---- その他 -----------------------------------------------------------
TZ=Asia/Tokyo
IG_RAY_WEB_PORT=8079
