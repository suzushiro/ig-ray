# insta-ray web（表示層）
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        tini sqlite3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY app/requirements-web.txt /app/requirements-web.txt
RUN pip install --no-cache-dir -r /app/requirements-web.txt

COPY app/ /app/

RUN useradd --create-home --uid 1000 --shell /bin/bash insta \
    && mkdir -p /data \
    && chown -R insta:insta /data /app
USER insta

ENV INSTA_RAY_DB=/data/insta_ray.db \
    INSTA_RAY_CACHE=/data/cache

EXPOSE 8079
ENTRYPOINT ["/usr/bin/tini", "--"]
# waitress で配信。web は読み取り専用の想定（書き込みは worker 側）
CMD ["waitress-serve", "--host=0.0.0.0", "--port=8079", "web:app"]
